{
  // UniHelper — Telegram Mini App + утренняя сводка
  "name": "uni-helper",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // раз в час; сводка уходит тем, у кого в этот момент 7 утра по их часовому поясу
  "triggers": { "crons": ["0 * * * *"] },
  // хранилище создастся само при первом деплое (id указывать не нужно)
  "kv_namespaces": [{ "binding": "USERS" }],
  "observability": { "enabled": true }
}
